+// ---- Q4 input record/replay (env Q4_INPUT_RECORD=<file>, Q4_INPUT_REPLAY=<file>) ----
+namespace {
+struct Q4PadEv { long long ms; unsigned buttons, lt, rt; int lx, ly, rx, ry; };
+std::mutex g_q4_mu;
+std::vector<Q4PadEv> g_q4_replay;
+bool g_q4_loaded = false;
+FILE* g_q4_rec = nullptr;
+bool g_q4_rec_init = false;
+std::chrono::steady_clock::time_point g_q4_t0;
+bool g_q4_t0_set = false;
+Q4PadEv g_q4_last{-1, 0, 0, 0, 0, 0, 0, 0};
+
+long long Q4Elapsed() {
+  if (!g_q4_t0_set) { g_q4_t0 = std::chrono::steady_clock::now(); g_q4_t0_set = true; }
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - g_q4_t0).count();
+}
+// Returns true if state was replaced by replay.
+bool Q4Replay(uint32_t user_index, rex::input::X_INPUT_STATE* out) {
+  if (user_index != 0) return false;
+  const char* path = std::getenv("Q4_INPUT_REPLAY");
+  if (!path || !*path) return false;
+  std::lock_guard<std::mutex> lk(g_q4_mu);
+  if (!g_q4_loaded) {
+    g_q4_loaded = true;
+    if (FILE* f = std::fopen(path, "r")) {
+      Q4PadEv e;
+      while (std::fscanf(f, "%lld %u %u %u %d %d %d %d", &e.ms, &e.buttons, &e.lt, &e.rt, &e.lx, &e.ly, &e.rx, &e.ry) == 8)
+        g_q4_replay.push_back(e);
+      std::fclose(f);
+    }
+  }
+  long long now = Q4Elapsed();
+  Q4PadEv cur{0, 0, 0, 0, 0, 0, 0, 0};
+  for (const auto& e : g_q4_replay) { if (e.ms <= now) cur = e; else break; }
+  static uint32_t pkt = 0;
+  out->packet_number = ++pkt;
+  out->gamepad.buttons = (uint16_t)cur.buttons;
+  out->gamepad.left_trigger = (uint8_t)cur.lt;
+  out->gamepad.right_trigger = (uint8_t)cur.rt;
+  out->gamepad.thumb_lx = (int16_t)cur.lx;
+  out->gamepad.thumb_ly = (int16_t)cur.ly;
+  out->gamepad.thumb_rx = (int16_t)cur.rx;
+  out->gamepad.thumb_ry = (int16_t)cur.ry;
+  return true;
+}
+void Q4Record(uint32_t user_index, const rex::input::X_INPUT_STATE& st) {
+  if (user_index != 0) return;
+  std::lock_guard<std::mutex> lk(g_q4_mu);
+  if (!g_q4_rec_init) {
+    g_q4_rec_init = true;
+    const char* path = std::getenv("Q4_INPUT_RECORD");
+    if (path && *path) g_q4_rec = std::fopen(path, "w");
+  }
+  if (!g_q4_rec) return;
+  Q4PadEv e{Q4Elapsed(), (unsigned)(uint16_t)st.gamepad.buttons, st.gamepad.left_trigger, st.gamepad.right_trigger,
+            (int)(int16_t)st.gamepad.thumb_lx, (int)(int16_t)st.gamepad.thumb_ly,
+            (int)(int16_t)st.gamepad.thumb_rx, (int)(int16_t)st.gamepad.thumb_ry};
+  if (e.buttons == g_q4_last.buttons && e.lt == g_q4_last.lt && e.rt == g_q4_last.rt && e.lx == g_q4_last.lx &&
+      e.ly == g_q4_last.ly && e.rx == g_q4_last.rx && e.ry == g_q4_last.ry)
+    return;
+  g_q4_last = e;
+  std::fprintf(g_q4_rec, "%lld %u %u %u %d %d %d %d\n", e.ms, e.buttons, e.lt, e.rt, e.lx, e.ly, e.rx, e.ry);
