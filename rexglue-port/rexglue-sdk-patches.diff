+namespace {
+// Waits on the real display's vertical blank so the emulated guest vblank can be phase-locked
+// to it. Without this the guest's frames arrive at an arbitrary, drifting phase relative to the
+// host display refresh, and whenever a frame lands close to a refresh boundary, timing jitter
+// makes the display show one frame twice and skip another (regular visible hitching).
+struct DisplayVBlank {
+  IDXGIFactory1* factory = nullptr;
+  IDXGIAdapter1* adapter = nullptr;
+  IDXGIOutput* output = nullptr;
+  int divisor = 1;
+  int count = 0;
+  double refresh_hz = 0.0;
+  ~DisplayVBlank() {
+    if (output) output->Release();
+    if (adapter) adapter->Release();
+    if (factory) factory->Release();
+  }
+  // guest_hz: the emulated console refresh (60). Succeeds only if the display refresh is
+  // (about) a whole multiple of it, e.g. 60, 120, 180 Hz.
+  bool Init(double guest_hz) {
+    HMODULE mod = LoadLibraryW(L"dxgi.dll");
+    if (!mod) return false;
+    using Fn = HRESULT(WINAPI*)(REFIID, void**);
+    auto fn = reinterpret_cast<Fn>(GetProcAddress(mod, "CreateDXGIFactory1"));
+    if (!fn || FAILED(fn(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory)))) return false;
+    if (FAILED(factory->EnumAdapters1(0, &adapter))) return false;
+    if (FAILED(adapter->EnumOutputs(0, &output))) return false;
+    using clk = std::chrono::steady_clock;
+    if (FAILED(output->WaitForVBlank())) return false;
+    const auto t0 = clk::now();
+    constexpr int kSamples = 20;
+    for (int i = 0; i < kSamples; ++i) {
+      if (FAILED(output->WaitForVBlank())) return false;
+    }
+    refresh_hz = kSamples / std::chrono::duration<double>(clk::now() - t0).count();
+    const int div = static_cast<int>(refresh_hz / guest_hz + 0.5);
+    if (div < 1 || std::abs(refresh_hz / div - guest_hz) > guest_hz * 0.03) return false;
+    divisor = div;
+    return true;
+  }
+  // Blocks until the next guest tick (every `divisor` display vblanks).
+  bool WaitTick() {
+    do {
+      if (FAILED(output->WaitForVBlank())) return false;
+    } while (++count % divisor != 0);
+    return true;
+  }
+};
